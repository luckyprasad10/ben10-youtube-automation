# ==========================================
# BEN 10 TO YOUTUBE AUTOMATION CONFIG
# ==========================================

# Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive Source Folder ID (default Ben 10 folder)
DRIVE_FOLDER_ID=1qUUMEioaCH-LiWTYNwFmADLNF73JRE5N

# YouTube Channel Brand
CHANNEL_HANDLE=@krylox ai

# YouTube Data API v3 OAuth Credentials
# (Obtained from Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Default Upload Privacy: 'unlisted' (recommended for safety checks) or 'public'
DEFAULT_PRIVACY_STATUS=unlisted

# Monetization & Community Links (Traffic Funnel)
TELEGRAM_CHANNEL_URL=https://t.me/your_channel
MONETIZATION_DOWNLOAD_URL=https://t.me/your_channel
AFFILIATE_LINK=https://amzn.to/example

# Automation Mode: 'full' (full episode), 'short' (60s short), or 'both'
CONTENT_MODE=both
